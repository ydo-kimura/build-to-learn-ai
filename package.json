{
  "name": "ai-curriculum",
  "version": "1.0.0",
  "description": "AI Engineering curriculum",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:check-h2-separators": "node --test scripts/verify_markdown_h2_separators.test.mjs && node scripts/verify_markdown_h2_separators.mjs",
    "docs:check-ja-bold": "node --test scripts/verify_ja_markdown_bold.test.mjs && node scripts/verify_ja_markdown_bold.mjs",
    "docs:check-mermaid": "python3 scripts/verify_mermaid_blocks.py",
    "docs:check-diagrams": "python3 scripts/verify_curriculum_diagrams.py && python3 scripts/verify_curriculum_diagram_geometry.py && pnpm run docs:check-mermaid && pnpm run docs:check-ja-bold && pnpm run docs:check-h2-separators",
    "docs:build": "pnpm run docs:check-diagrams && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "security:trivy": "trivy fs --include-dev-deps --scanners vuln,secret,misconfig --severity MEDIUM,HIGH,CRITICAL --ignore-unfixed --exit-code 1 --skip-dirs node_modules,.pnpm-store,docs/.vitepress/cache,docs/.vitepress/dist,.devcontainer,.git,graft,openwiki,aidlc-docs,.aidlc-rule-details,__pycache__ ."
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "mermaid": "^12.3.0",
    "prettier": "^3.10.1",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-renderer": "^1.2.3",
    "vue": "^3.5.46"
  }
}
